    <ui:InvokeCode ContinueOnError="{x:Null}" Code="if (!System.IO.File.Exists(logPath)) { stats = &quot;{\&quot;error\&quot;:\&quot;no log file\&quot;}&quot;; return; }&#xA;&#xA;var lines = System.IO.File.ReadAllLines(logPath, System.Text.Encoding.UTF8);&#xA;DateTime cutoff = DateTime.Now.AddDays(-7);&#xA;&#xA;int total = 0, actionable = 0, informational = 0, failed = 0;&#xA;int tasks = 0, meetings = 0, replyDrafts = 0, high = 0;&#xA;var senders = new Dictionary&lt;string,int&gt;();&#xA;&#xA;for (int i = 1; i &lt; lines.Length; i++) {&#xA;    var f = new List&lt;string&gt;();&#xA;    bool inQ = false; var cur = new System.Text.StringBuilder();&#xA;    foreach (char c in lines[i]) {&#xA;        if (c == '&quot;') { inQ = !inQ; }&#xA;        else if (c == ',' &amp;&amp; !inQ) { f.Add(cur.ToString()); cur.Clear(); }&#xA;        else { cur.Append(c); }&#xA;    }&#xA;    f.Add(cur.ToString());&#xA;    if (f.Count &lt; 10) continue;&#xA;&#xA;    DateTime ts;&#xA;    if (!DateTime.TryParse(f[0], out ts) || ts &lt; cutoff) continue;&#xA;&#xA;    total++;&#xA;    if (f[3] == &quot;actionable&quot;) actionable++;&#xA;    if (f[3] == &quot;informational&quot;) informational++;&#xA;    if (f[7].StartsWith(&quot;FAILED&quot;)) failed++;&#xA;    if (f[4] == &quot;High&quot;) high++;&#xA;    if (f[8] == &quot;Yes&quot;) replyDrafts++;&#xA;&#xA;    int n;&#xA;    if (int.TryParse(f[5], out n)) tasks += n;&#xA;    if (int.TryParse(f[6], out n)) meetings += n;&#xA;&#xA;    string s = f[1];&#xA;    if (!senders.ContainsKey(s)) senders[s] = 0;&#xA;    senders[s]++;&#xA;}&#xA;&#xA;var top = senders.OrderByDescending(kv =&gt; kv.Value).Take(5)&#xA;                 .Select(kv =&gt; &quot;\&quot;&quot; + kv.Key.Replace(&quot;\&quot;&quot;,&quot;'&quot;) + &quot;\&quot;:&quot; + kv.Value);&#xA;&#xA;stats = &quot;{\&quot;total\&quot;:&quot; + total + &quot;,\&quot;actionable\&quot;:&quot; + actionable&#xA;      + &quot;,\&quot;informational\&quot;:&quot; + informational + &quot;,\&quot;failed\&quot;:&quot; + failed&#xA;      + &quot;,\&quot;tasks\&quot;:&quot; + tasks + &quot;,\&quot;meetings\&quot;:&quot; + meetings&#xA;      + &quot;,\&quot;replyDraftsCreated\&quot;:&quot; + replyDrafts + &quot;,\&quot;high\&quot;:&quot; + high&#xA;      + &quot;,\&quot;topSenders\&quot;:{&quot; + String.Join(&quot;,&quot;, top) + &quot;}}&quot;;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,288" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
