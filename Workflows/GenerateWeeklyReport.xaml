    <ui:InvokeCode ContinueOnError="{x:Null}" Code="var j = Newtonsoft.Json.Linq.JObject.Parse(statsJson);&#xA;var sb = new System.Text.StringBuilder();&#xA;&#xA;sb.AppendLine(&quot;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;/head&gt;&lt;body&gt;&quot;);&#xA;sb.AppendLine(&quot;&lt;h2&gt;AI Email Assistant — Weekly Report&lt;/h2&gt;&quot;);&#xA;sb.AppendLine(&quot;&lt;p&gt;&lt;b&gt;Period:&lt;/b&gt; &quot; + DateTime.Now.AddDays(-7).ToString(&quot;yyyy-MM-dd&quot;)&#xA;            + &quot; to &quot; + DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;) + &quot;&lt;/p&gt;&quot;);&#xA;sb.AppendLine(&quot;&lt;p&gt;&quot; + narrative + &quot;&lt;/p&gt;&quot;);&#xA;sb.AppendLine(&quot;&lt;table border='1' cellpadding='6' style='border-collapse:collapse'&gt;&quot;);&#xA;sb.AppendLine(&quot;&lt;tr style='background:#DDEBF7'&gt;&lt;th&gt;Metric&lt;/th&gt;&lt;th&gt;Value&lt;/th&gt;&lt;/tr&gt;&quot;);&#xA;&#xA;Action&lt;string,string&gt; row = (k,v) =&gt;&#xA;    sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;&quot; + k + &quot;&lt;/td&gt;&lt;td align='right'&gt;&quot; + v + &quot;&lt;/td&gt;&lt;/tr&gt;&quot;);&#xA;&#xA;row(&quot;Emails processed&quot;,     j[&quot;total&quot;].ToString());&#xA;row(&quot;Actionable&quot;,           j[&quot;actionable&quot;].ToString());&#xA;row(&quot;Informational&quot;,        j[&quot;informational&quot;].ToString());&#xA;row(&quot;High priority&quot;,        j[&quot;high&quot;].ToString());&#xA;row(&quot;Tasks created&quot;,        j[&quot;tasks&quot;].ToString());&#xA;row(&quot;Meetings created&quot;,     j[&quot;meetings&quot;].ToString());&#xA;row(&quot;Reply drafts created&quot;, j[&quot;replyDraftsCreated&quot;].ToString());&#xA;row(&quot;Failed&quot;,               j[&quot;failed&quot;].ToString());&#xA;&#xA;sb.AppendLine(&quot;&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;&quot;);&#xA;&#xA;string dir = System.IO.Path.GetDirectoryName(outPath);&#xA;if (!String.IsNullOrEmpty(dir) &amp;&amp; !System.IO.Directory.Exists(dir))&#xA;    System.IO.Directory.CreateDirectory(dir);&#xA;&#xA;System.IO.File.WriteAllText(outPath.Replace(&quot;.xlsx&quot;, &quot;.html&quot;), sb.ToString(),&#xA;    new System.Text.UTF8Encoding(true));" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,288" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="CSharp">
